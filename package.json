{
  "name": "wrapped-recommendations",
  "version": "1.0.0",
  "private": true,
  "description": "Spotify Wrapped-style song recommendation system",
  "scripts": {
    "dev": "npm run kill:port && concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "kill:port": "node scripts/kill-port.js 8000",
    "dev:backend": "cd backend && .\\venv\\Scripts\\python.exe -m app.main",
    "dev:frontend": "cd spotify-frontend && npm run dev",
    "build": "npm run build:frontend",
    "build:frontend": "cd spotify-frontend && npm run build",
    "build:backend": "cd backend && .\\venv\\Scripts\\python.exe -m pip install -r requirements.txt",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && .\\venv\\Scripts\\python.exe -m pytest tests/ -v",
    "test:frontend": "cd spotify-frontend && npm run typecheck",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd backend && .\\venv\\Scripts\\python.exe -m flake8 app/ --max-line-length=100",
    "lint:frontend": "cd spotify-frontend && npm run lint",
    "precompute": "cd backend && .\\venv\\Scripts\\python.exe scripts/precompute.py",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "clean": "rm -rf backend/__pycache__ backend/app/__pycache__ backend/app/**/__pycache__ spotify-frontend/node_modules spotify-frontend/dist"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "python": ">=3.11"
  }
}